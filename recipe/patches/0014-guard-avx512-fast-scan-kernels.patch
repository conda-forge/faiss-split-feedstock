From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tobias Fischer <info@tobiasfischer.info>
Date: Wed, 5 Aug 2026 10:30:00 +0930
Subject: [PATCH 14/14] Guard AVX512 fast-scan kernels with compile definition

---
 faiss/impl/fast_scan/decompose_qbs.h   | 2 +-
 faiss/impl/fast_scan/kernels_simd512.h | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/faiss/impl/fast_scan/decompose_qbs.h b/faiss/impl/fast_scan/decompose_qbs.h
--- a/faiss/impl/fast_scan/decompose_qbs.h
+++ b/faiss/impl/fast_scan/decompose_qbs.h
@@ -38,6 +38,6 @@ void kernel_accumulate_block(
         ResultHandler& res,
         const Scaler& scaler) {
-#ifdef __AVX512F__
+#if defined(COMPILE_SIMD_AVX512) && defined(__AVX512F__)
     if constexpr (
             KernelSL == SIMDLevel::AVX512 ||
             KernelSL == SIMDLevel::AVX512_SPR) {
diff --git a/faiss/impl/fast_scan/kernels_simd512.h b/faiss/impl/fast_scan/kernels_simd512.h
--- a/faiss/impl/fast_scan/kernels_simd512.h
+++ b/faiss/impl/fast_scan/kernels_simd512.h
@@ -10,7 +10,7 @@
 #include <faiss/impl/platform_macros.h>
 #include <faiss/impl/simdlib/simdlib_dispatch.h>
 
-#ifdef __AVX512F__
+#if defined(COMPILE_SIMD_AVX512) && defined(__AVX512F__)
 
 namespace faiss {
 
@@ -476,4 +476,4 @@ void pq4_kernel_qbs_512(
 
 } // namespace faiss
 
-#endif // __AVX512F__
+#endif // COMPILE_SIMD_AVX512 && __AVX512F__
