From 5a5cf87826a2881def2bb50420f530ef3b6ea9a8 Mon Sep 17 00:00:00 2001
From: "H. Vetinari" <h.vetinari@gmx.com>
Date: Thu, 8 Aug 2024 15:40:34 +1100
Subject: [PATCH 09/11] don't rely on luck for initialization order on win+CUDA

---
 faiss/gpu/GpuIndex.cu | 19 -------------------
 faiss/utils/utils.cpp | 10 +++++++++-
 2 files changed, 9 insertions(+), 20 deletions(-)

diff --git a/faiss/gpu/GpuIndex.cu b/faiss/gpu/GpuIndex.cu
index 4b8047a4..9abac61b 100644
--- a/faiss/gpu/GpuIndex.cu
+++ b/faiss/gpu/GpuIndex.cu
@@ -747,23 +747,4 @@ bool isGpuIndexImplemented(faiss::Index* index) {
 
 } // namespace gpu
 
-// This is the one defined in utils.cpp
-extern std::string& ref_gpu_compile_options();
-
-struct InitGpuCompileOptions {
-    InitGpuCompileOptions() {
-        ref_gpu_compile_options() = std::string("GPU ") +
-#ifdef USE_NVIDIA_CUVS
-                "NVIDIA_CUVS " +
-#endif
-
-#ifdef USE_AMD_ROCM
-                "AMD_ROCM " +
-#endif
-                "";
-    }
-};
-
-InitGpuCompileOptions InitGpuCompileOptions_instance;
-
 } // namespace faiss
diff --git a/faiss/utils/utils.cpp b/faiss/utils/utils.cpp
index 85fbc113..ecb87e39 100644
--- a/faiss/utils/utils.cpp
+++ b/faiss/utils/utils.cpp
@@ -104,7 +104,15 @@ namespace faiss {
 
 // this will be set at load time from GPU Faiss
 std::string& ref_gpu_compile_options() {
-    static std::string gpu_compile_options;
+    static std::string gpu_compile_options = std::string("GPU ") +
+#ifdef USE_NVIDIA_CUVS
+            "NVIDIA_CUVS " +
+#endif
+
+#ifdef USE_AMD_ROCM
+            "AMD_ROCM " +
+#endif
+            "";
     return gpu_compile_options;
 }
 
